{
  "name": "frost-price-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json *.html *.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html *.md .github/workflows/*.yml",
    "check:privacy": "node scripts/privacy-check.mjs",
    "validate:workbook": "tsx scripts/validate-workbook.ts"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "fflate": "^0.8.2",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
